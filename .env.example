PORT=3001
HOST=127.0.0.1
# Keep 0 for direct access; the optional Caddy container sets one trusted hop.
TRUST_PROXY_HOPS=0
# Optional native HTTPS. Use a certificate trusted by each connecting device.
# Leave both blank when using localhost HTTP or an HTTPS reverse proxy.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Alternatively, use a Windows PKCS#12 certificate instead of the PEM pair.
TLS_PFX_FILE=
TLS_PFX_PASSPHRASE=
# Optional Docker HTTPS proxy domain; point its DNS at the hub before starting.
SMRIVA_DOMAIN=
# Blank chooses an existing legacy database, or ./data/setusync.sqlite for a new install.
DATABASE_PATH=
# Generate 32 random bytes as hex. Required outside demo mode.
HUB_ENCRYPTION_KEY=
DEMO_JUDGE_MODE=true
SEED_DEMO_DATA=true
DEMO_ENROLLMENT_CODE=setusync-demo-2026
# Set only for first administrator enrollment outside demo mode. Use npm run setup:production.
BOOTSTRAP_TOKEN=
ALLOWED_ORIGIN=http://localhost:5173
# Public HTTPS origin when deployed, e.g. https://smriva.your-domain.org (no trailing path).
# Leave blank locally. Canonical URLs and sitemap entries are generated only when configured.
SITE_URL=
# Optional peer hub: same school and peer shared secret on both hubs.
PEER_HUB_URL=
PEER_SHARED_SECRET=
