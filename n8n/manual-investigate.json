      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
    },
    {
      "id": "run-investigator",
      "name": "Run investigator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
