{
  "name": "smriva",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Education records with durable offline sync.",
  "scripts": {
    "dev": "concurrently -k -n hub,pwa \"tsx watch apps/hub/src/index.ts\" \"vite --host 0.0.0.0 --configLoader runner\"",
    "build": "tsx packages/content/verify.ts && tsc --noEmit && vite build --configLoader runner && tsx scripts/prepare-site.tsx",
    "start": "tsx apps/hub/src/index.ts",
    "start:lan": "tsx apps/hub/src/index.ts --lan",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "test:e2e": "playwright test",
    "test:devices": "playwright test --config playwright.devices.config.ts",
    "chaos": "tsx packages/chaos/src/benchmark.ts",
    "data:fetch": "tsx packages/content/fetch.ts && tsx scripts/prepare-content.ts",
    "data:verify": "tsx packages/content/verify.ts",
    "content:prepare": "tsx scripts/prepare-content.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.json docs/*.md README.md",
    "setup:production": "tsx scripts/configure.ts",
    "db:inspect": "tsx scripts/database.ts inspect",
    "db:invite": "tsx scripts/database.ts invite",
    "db:backup": "tsx scripts/database.ts backup",
    "audit:site": "node scripts/quality-audit.mjs --serve --lighthouse --out docs/site-audit.json",
    "assets:prepare": "node scripts/prepare-site-assets.mjs",
    "library:fetch": "tsx scripts/fetch-government-images.ts && tsx scripts/prepare-content.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dexie": "^4.2.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "fake-indexeddb": "^6.2.0",
    "fast-check": "^4.3.0",
    "lighthouse": "13.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
