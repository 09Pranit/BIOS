# Offline demo works without vendor credentials. Never enable judge mode on a public deployment.
DEMO_JUDGE_MODE=true
PORT=3001
WEB_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=info
# MojoAuth OIDC application; server-only values
MOJOAUTH_ISSUER=
MOJOAUTH_CLIENT_ID=
MOJOAUTH_CLIENT_SECRET=
MOJOAUTH_REDIRECT_URI=http://localhost:5173/api/auth/mojo/callback
MOJOAUTH_AUDIENCE=
MOJOAUTH_REVIEWER_SUBJECTS=
# Optional LLM planner. Set a model ID available to your Anthropic account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
BENCHMARK_USE_LLM=false
# Optional Langfuse tracing. These keys never enter the client bundle.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Generate a strong random value and use the same Header Auth credential in n8n.
N8N_SHARED_SECRET=
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=
N8N_REVIEW_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_URL=
