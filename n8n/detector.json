{
  "name": "ServiceShield — metric detector",
  "nodes": [
    {
      "id": "every-five-minutes",
      "name": "Every five minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "latest-metrics",
      "name": "Latest metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SERVICESHIELD_API_URL + \"/api/metrics/latest\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
    },
    {
      "id": "breach",
      "name": "Breach",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "breach",
              "leftValue": "={{ $json.breach }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "create-case",
      "name": "Create case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SERVICESHIELD_API_URL + \"/api/cases\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({scenario:\"pool\",seed:42,stress:{clockOffset:15,logLoss:20}}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
    },
    {
      "id": "investigate",
      "name": "Investigate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SERVICESHIELD_API_URL + \"/api/investigate\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({case_id:$json.id}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
    },
    {
      "id": "record-detector",
      "name": "Record detector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SERVICESHIELD_API_URL + \"/api/automation/status\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({execution_id:$execution.id,case_id:$('Create case').first().json.id,workflow:'metric detector',status:'success',detail:'Synthetic metric threshold breached; investigator dispatched.'}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
    }
  ],
  "connections": {
    "Every five minutes": {
      "main": [
        [
          {
            "node": "Latest metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Latest metrics": {
      "main": [
        [
          {
            "node": "Breach",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Breach": {
      "main": [
        [
          {
            "node": "Create case",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create case": {
      "main": [
        [
          {
            "node": "Investigate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Investigate": {
      "main": [
        [
          {
            "node": "Record detector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "933ad618-7efc-4fa6-bd28-ffd487109f90",
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
