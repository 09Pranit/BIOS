{
  "name": "ServiceShield — nightly benchmark and calibration",
  "nodes": [
    {
      "id": "nightly-at-02:00",
      "name": "Nightly at 02:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "refresh-benchmark",
      "name": "Refresh benchmark",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SERVICESHIELD_API_URL + \"/api/benchmark/refresh\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
    },
    {
      "id": "record-nightly-dispatch",
      "name": "Record nightly dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SERVICESHIELD_API_URL + \"/api/automation/status\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({execution_id:$execution.id,case_id:null,workflow:'nightly benchmark dispatch',status:'success',detail:'Benchmark child process accepted as '+$json.execution_id+'. Its real completion is recorded separately by the API.'}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
    }
  ],
  "connections": {
    "Nightly at 02:00": {
      "main": [
        [
          {
            "node": "Refresh benchmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh benchmark": {
      "main": [
        [
          {
            "node": "Record nightly dispatch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "52e7ef07-55c9-4576-b5ea-69a96eb66bdf",
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
