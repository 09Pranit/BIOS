        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({case_id: $json.body.case_id}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
    },
    {
      "id": "record-execution",
      "name": "Record execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SERVICESHIELD_API_URL + \"/api/automation/status\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({execution_id: $execution.id,case_id: $('Investigate now').first().json.body.case_id,workflow: 'manual investigation',status: 'success',detail:'Investigation dispatched; report status is tracked by the case API.'}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "serviceshield-header-auth",
          "name": "ServiceShield shared secret"
        }
      }
